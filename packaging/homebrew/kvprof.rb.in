# Generated by the release workflow from packaging/homebrew/kvprof.rb.in in noahg/kvprof; edit it there.
cask "kvprof" do
  arch arm: "arm64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_ARM64@",
         intel: "@SHA256_X86_64@"

  url "https://github.com/noahg/kvprof/releases/download/v#{version}/kvprof-#{version}-macos-#{arch}.dmg"
  name "kvprof"
  desc "Prompt-cache profiler for llama.cpp's llama-server"
  homepage "https://github.com/noahg/kvprof"

  depends_on macos: ">= :ventura"

  app "kvprof.app"
  binary "#{appdir}/kvprof.app/Contents/Resources/runtime/bin/kvprof"

  zap trash: [
    "~/Library/Application Support/kvprof",
    "~/Library/Logs/kvprof",
    "~/Library/Preferences/io.github.noahg.kvprof.plist",
  ]
end
